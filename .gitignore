# Rust build artefacts
/target
debug
# rustfmt backup files
**/*.rs.bk
# MSVC debug info
*.pdb
# cargo-mutants output
**/mutants.out*/

# reference papers
*.pdf

# Per-crate transient bench output (cargo bench CWD is the crate dir).
# Paper-figure CSVs live in `results/paper/` and are tracked.
/segmented-cuckoo/results
/ikpir-server/results
/ikpir-client/results

# Ignore everything in `results/` except the curated subtree that backs the paper.
results/*
!results/.gitkeep
!results/README.md
!results/SCHEMA.md
!results/paper/
!results/plots/

# Generated server-side benchmark result CSVs (reproducible via scripts/).
/server-results/*.csv

# Python tooling for scripts/
.venv/
__pycache__/
*.pyc

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local cargo config
.cargo/config.toml
